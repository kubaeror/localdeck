{
  "name": "@localdeck/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "LocalDeck end-to-end smoke tests (Playwright) against an external LocalStack",
  "type": "module",
  "scripts": {
    "smoke": "playwright test",
    "smoke:headed": "playwright test --headed",
    "smoke:report": "playwright show-report",
    "screens": "tsx scripts/capture-screenshots.ts",
    "lint": "eslint tests scripts playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf playwright-report test-results .turbo"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
