{
  "name": "@localdeck/api",
  "version": "0.1.0",
  "private": true,
  "description": "LocalDeck backend — proxies the external LocalStack instance",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:localstack": "tsx scripts/verify-localstack.ts",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.1135.0",
    "@aws-sdk/client-auto-scaling": "^3.1135.0",
    "@aws-sdk/client-cloudformation": "^3.1135.0",
    "@aws-sdk/client-cloudfront": "^3.1135.0",
    "@aws-sdk/client-cloudwatch": "^3.1135.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1135.0",
    "@aws-sdk/client-dynamodb": "^3.1135.0",
    "@aws-sdk/client-ec2": "^3.1135.0",
    "@aws-sdk/client-ecr": "^3.1135.0",
    "@aws-sdk/client-ecs": "^3.1135.0",
    "@aws-sdk/client-eks": "^3.1135.0",
    "@aws-sdk/client-elasticache": "^3.1135.0",
    "@aws-sdk/client-eventbridge": "^3.1135.0",
    "@aws-sdk/client-iam": "^3.1135.0",
    "@aws-sdk/client-kinesis": "^3.1135.0",
    "@aws-sdk/client-kms": "^3.1135.0",
    "@aws-sdk/client-lambda": "^3.1135.0",
    "@aws-sdk/client-rds": "^3.1135.0",
    "@aws-sdk/client-route-53": "^3.1135.0",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/client-s3-control": "^3.1135.0",
    "@aws-sdk/client-secrets-manager": "^3.1135.0",
    "@aws-sdk/client-sfn": "^3.1135.0",
    "@aws-sdk/client-sns": "^3.1135.0",
    "@aws-sdk/client-sqs": "^3.1135.0",
    "@aws-sdk/client-ssm": "^3.1135.0",
    "@aws-sdk/client-sts": "^3.1135.0",
    "@aws-sdk/lib-storage": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@localdeck/shared": "workspace:*",
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3"
  }
}
