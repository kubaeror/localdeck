# LocalDeck environment overrides for `docker compose`.
# Copy to `.env` and adjust; docker-compose.yml reads these values.

# --- LocalStack connection (LocalStack is managed OUTSIDE this project) ---
# Docker Desktop (macOS / Windows) or a Linux engine where LocalStack is
# published on 0.0.0.0: use host.docker.internal.
LOCALSTACK_ENDPOINT=http://host.docker.internal:4566
#
# LocalStack published on the host loopback only (127.0.0.1:4566, typical for
# WSL2 + a Docker engine inside the same distro): the api container cannot see
# the host loopback over the bridge network. Run compose with the loopback
# override instead, which puts api on the host network and defaults
# LOCALSTACK_ENDPOINT to http://127.0.0.1:4566:
#   docker compose -f docker-compose.yml -f docker-compose.loopback.yml up
#
# Host-side `pnpm dev` (no containers) talks to LocalStack directly:
#   LOCALSTACK_ENDPOINT=http://localhost:4566

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- LocalDeck api ---
API_PORT=3001
LOG_LEVEL=info
# Comma-separated origins, or * to reflect the request origin.
CORS_ORIGIN=*

# --- LocalDeck ui ---
UI_PORT=8080
# Upstream used by the ui container's nginx to reach the api container.
API_UPSTREAM=http://api:3001
