# LocalDeck environment overrides for `docker compose`.
# Copy to `.env` and adjust; docker-compose.yml reads these values.
#
# Requires Docker Compose >= 2.24 (`docker compose version`), because the
# loopback override uses the `!reset` tag introduced in that release.

# --- Local emulator connection (the emulator is managed OUTSIDE this project) ---
# LocalDeck speaks to any local AWS emulator that serves the AWS wire protocol
# on one endpoint: LocalStack, MiniStack, Floci, or a generic AWS-compatible
# endpoint. The api auto-detects the provider from its health document; pin it
# with EMULATOR_PROVIDER=localstack|ministack|floci|generic when needed.
#
# Precedence: EMULATOR_ENDPOINT > AWS_ENDPOINT_URL > LOCALSTACK_ENDPOINT.
#
# Docker Desktop (macOS / Windows) or a Linux engine where the emulator is
# published on 0.0.0.0: use host.docker.internal.
EMULATOR_ENDPOINT=http://host.docker.internal:4566
# Legacy alias still honoured (LocalStack deployments keep working unchanged):
# LOCALSTACK_ENDPOINT=http://host.docker.internal:4566
# AWS_ENDPOINT_URL=http://host.docker.internal:4566
#
# Emulator published on the host loopback only (127.0.0.1:4566, typical for
# WSL2 + a Docker engine inside the same distro): the api container cannot see
# the host loopback over the bridge network. Run compose with the loopback
# override instead, which puts api on the host network and defaults
# EMULATOR_ENDPOINT to http://127.0.0.1:4566:
#   docker compose -f docker-compose.yml -f docker-compose.loopback.yml up
#
# Host-side `pnpm dev` (no containers) talks to the emulator directly:
#   EMULATOR_ENDPOINT=http://localhost:4566 pnpm dev
#
# Quick starts for the supported emulators:
#   LocalStack  docker run --rm -p 4566:4566 localstack/localstack
#   MiniStack   docker run --rm -p 4566:4566 ministackorg/ministack
#   Floci       docker run --rm -p 4566:4566 floci/floci:latest
EMULATOR_PROVIDER=auto

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Optional: temporary credentials that require a session token. Leave empty to
# send no token; the emulators accept any non-empty credentials by default.
AWS_SESSION_TOKEN=

# --- LocalDeck api ---
# The published api port is bound to the host loopback so the console is not
# exposed to the LAN; set API_BIND_ADDR=0.0.0.0 to publish it on all interfaces.
API_BIND_ADDR=127.0.0.1
API_PORT=3001
LOG_LEVEL=info
# Per-request timeout for emulator health probes, in milliseconds.
EMULATOR_TIMEOUT_MS=5000
# Outbound SDK timeouts (ms): connection establishment and whole-request.
EMULATOR_CONNECTION_TIMEOUT_MS=3000
EMULATOR_REQUEST_TIMEOUT_MS=30000
# How long the api caches a health probe (ms; 0 disables caching).
EMULATOR_HEALTH_CACHE_MS=2000
# Deadline (ms) for graceful shutdown before the api exits forcefully.
SHUTDOWN_TIMEOUT_MS=10000
# Endpoint written into generated kubeconfigs, which run on the host. Empty
# means "use EMULATOR_ENDPOINT"; set it to a host-reachable URL when the api
# runs in a container (e.g. http://localhost:4566).
EMULATOR_PUBLIC_ENDPOINT=
# How often the ui should refresh the status widget, in milliseconds.
UI_STATUS_POLL_INTERVAL_MS=15000
# Cross-origin access. Empty (the default) means same-origin only: the bundled
# ui reaches the api through nginx, and LocalDeck is an unauthenticated
# management proxy. Set CORS_ORIGIN=* only for a trusted split deployment.
CORS_ORIGIN=
# Legacy aliases: LOCALSTACK_TIMEOUT_MS, LOCALSTACK_CONNECTION_TIMEOUT_MS,
# LOCALSTACK_REQUEST_TIMEOUT_MS, LOCALSTACK_HEALTH_CACHE_MS and
# LOCALSTACK_PUBLIC_ENDPOINT are still honoured when the EMULATOR_* variable is
# unset.

# --- LocalDeck ui ---
UI_PORT=8080
# Runtime routing: the ui container's nginx proxies /api to this upstream, so
# the browser stays same-origin. Change it to point the ui at another api.
API_UPSTREAM=http://api:3001
#
# Build-time only: VITE_* values are compiled into the bundle when the ui image
# is built (they are not read at container start). Leave empty for the default
# same-origin `/api`; set it only when the api lives on another origin:
#   VITE_API_BASE_URL=http://localhost:3001
VITE_API_BASE_URL=
# Release builds also pass APP_VERSION through to the OCI labels.
APP_VERSION=dev
